  "api": {
    "name": "SubscriptionsPlugin",
    "slug": "subscriptionsplugin",
    "docs": "",
    "tags": [],
    "methods": [
      {
        "name": "echo",
        "signature": "(options: { value: string; }) => Promise<{ value: string; }>",
        "parameters": [
