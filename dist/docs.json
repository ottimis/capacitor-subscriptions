          }
        ],
        "returns": "Promise<{ value: string; }>",
        "tags": [],
        "docs": "A test method which just returns what is passed in",
        "complexTypes": [],
        "slug": "echo"
      },
      {
        "name": "getProductDetails",
        "signature": "(options: { productIdentifier: string; productType?: AndroidProductType; }) => Promise<ProductDetailsResponse>",
        "parameters": [
          {
            "name": "options",
            "docs": "",
            "type": "{ productIdentifier: string; productType?: AndroidProductType | undefined; }"
          }
        ],
        "returns": "Promise<ProductDetailsResponse>",
        "tags": [],
        "docs": "Receives a product ID and returns the product details.\n\nOn Android `productType` selects subscriptions (default) or one-time products. For subscriptions,\n`price` is the first pricing phase of the offer that `purchaseProduct` buys, and `pricingPhases`\nlists all the phases of that offer.",
        "complexTypes": [
          "ProductDetailsResponse",
          "AndroidProductType"
        ],
        "slug": "getproductdetails"
      },
      {
        "name": "purchaseProduct",
        "signature": "(options: { productIdentifier: string; accountId?: string; acknowledgePurchases?: boolean; productType?: AndroidProductType; }) => Promise<PurchaseProductResponse>",
        "parameters": [
          {
            "name": "options",
            "docs": "",
            "type": "{ productIdentifier: string; accountId?: string | undefined; acknowledgePurchases?: boolean | undefined; productType?: AndroidProductType | undefined; }"
          }
        ],
        "returns": "Promise<PurchaseProductResponse>",
        "tags": [],
        "docs": "Starts the purchase of a product.\n\nOn iOS the promise resolves with the transaction. On Android it resolves as soon as the native popover\nis open: the outcome arrives with the `ANDROID-PURCHASE-RESPONSE` event.\n\n`accountId` (optional): on iOS it must be a UUID and becomes the `appAccountToken` (otherwise the\ncall resolves with `1` \"Invalid accountId\"); on Android it becomes the `obfuscatedAccountId`.\n\n`acknowledgePurchases` (Android, default `true`): when `false` the plugin does not acknowledge the\npurchase, and the app or its backend must do it within 3 days (see `acknowledgePurchase`).",
        "complexTypes": [
          "PurchaseProductResponse",
          "AndroidProductType"
        ],
        "slug": "purchaseproduct"
      },
      {
        "name": "getCurrentEntitlements",
        "signature": "(options: { productType?: AndroidProductType; sync?: boolean; }) => Promise<CurrentEntitlementsResponse>",
        "parameters": [
          {
            "name": "options",
            "docs": "",
            "type": "{ productType?: AndroidProductType | undefined; sync?: boolean | undefined; }"
          }
        ],
        "returns": "Promise<CurrentEntitlementsResponse>",
        "tags": [],
        "docs": "Returns the purchases the user currently owns.\n\nOn Android each call returns one product type, `productType` (default `subs`); on iOS all the current\nentitlements are returned. On Android each entry has `isAcknowledged` and `purchaseState`, so that purchases still waiting to be\nacknowledged can be recovered.",
        "complexTypes": [
          "CurrentEntitlementsResponse",
          "AndroidProductType"
        ],
        "slug": "getcurrententitlements"
      },
      {
        "name": "getLatestTransaction",
        "signature": "(options: { productIdentifier: string; }) => Promise<LatestTransactionResponse>",
        "parameters": [
          {
            "name": "options",
            "docs": "",
            "type": "{ productIdentifier: string; }"
          }
        ],
        "returns": "Promise<LatestTransactionResponse>",
        "tags": [],
        "docs": "Returns the latest transaction of a product.\n\nOn Android (Billing 8) only subscriptions the user currently owns are found, including suspended\nones (account hold, paused), flagged with `isSuspended`. Expired subscriptions are not returned.",
        "complexTypes": [
          "LatestTransactionResponse"
        ],
        "slug": "getlatesttransaction"
      },
      {
        "name": "refundLatestTransaction",
        "signature": "(options: { productIdentifier: string; }) => Promise<RefundLatestTransactionResponse>",
        "parameters": [
          {
            "name": "options",
            "docs": "",
            "type": "{ productIdentifier: string; }"
          }
        ],
        "returns": "Promise<RefundLatestTransactionResponse>",
        "tags": [],
        "docs": "Opens the refund request sheet for the latest transaction of a product. iOS only: on Android it\nresolves with `-1`.",
        "complexTypes": [
          "RefundLatestTransactionResponse"
        ],
        "slug": "refundlatesttransaction"
      },
      {
        "name": "manageSubscriptions",
        "signature": "(options?: { productIdentifier?: string | undefined; bid?: string | undefined; } | undefined) => any",
        "parameters": [
          {
            "name": "options",
            "docs": "",
            "type": "{ productIdentifier?: string | undefined; bid?: string | undefined; } | undefined"
          }
        ],
        "returns": "any",
        "tags": [],
        "docs": "Opens the store page where the user manages subscriptions.\nOn Android `productIdentifier` and `bid` (the application id) are required.",
        "complexTypes": [],
        "slug": "managesubscriptions"
      },
      {
        "name": "acknowledgePurchase",
        "signature": "(options: { purchaseToken: string; }) => Promise<AcknowledgePurchaseResponse>",
        "parameters": [
          {
            "name": "options",
            "docs": "",
            "type": "{ purchaseToken: string; }"
          }
        ],
        "returns": "Promise<AcknowledgePurchaseResponse>",
        "tags": [
          {
            "name": "since",
            "text": "8.0.0"
          }
        ],
        "docs": "Acknowledges an Android purchase. Needed when `purchaseProduct` was called with\n`acknowledgePurchases: false` and the backend does not acknowledge it: Google refunds purchases\nnot acknowledged within 3 days. On iOS it resolves with `-1`.",
        "complexTypes": [
          "AcknowledgePurchaseResponse"
        ],
        "slug": "acknowledgepurchase"
      },
      {
        "name": "consumePurchase",
        "signature": "(options: { purchaseToken: string; }) => Promise<ConsumePurchaseResponse>",
        "parameters": [
          {
            "name": "options",
            "docs": "",
            "type": "{ purchaseToken: string; }"
          }
        ],
        "returns": "Promise<ConsumePurchaseResponse>",
        "tags": [
          {
            "name": "since",
            "text": "8.0.0"
          }
        ],
        "docs": "Consumes an Android one-time purchase, so that it can be bought again. Consuming also\nacknowledges it. On iOS it resolves with `-1`: consumables are finished by the plugin.",
        "complexTypes": [
          "ConsumePurchaseResponse"
        ],
        "slug": "consumepurchase"
      },
      {
        "name": "setGoogleVerificationDetails",
        "signature": "(options: { googleVerifyEndpoint: string; bid: string; }) => Promise<void>",
        "parameters": [
          {
            "name": "options",
            "docs": "",
            "type": "{ googleVerifyEndpoint: string; bid: string; }"
          }
        ],
        "returns": "Promise<void>",
        "tags": [
          {
            "name": "deprecated",
            "text": "The server-side verification it configured is no longer used. It will be removed in a\nfuture major version."
          }
        ],
        "docs": "**Deprecated**: does nothing and resolves immediately, on every platform. Remove the call.",
        "complexTypes": [],
        "slug": "setgoogleverificationdetails"
      },
      {
        "name": "addListener",
        "signature": "(eventName: 'ANDROID-PURCHASE-RESPONSE', listenerFunc: (response: AndroidPurchasedTrigger) => void) => Promise<PluginListenerHandle>",
        "parameters": [
          {
            "name": "eventName",
            "docs": "",
            "type": "'ANDROID-PURCHASE-RESPONSE'"
