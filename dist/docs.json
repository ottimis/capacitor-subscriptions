          }
        ],
        "returns": "Promise<PluginListenerHandle>",
        "tags": [],
        "docs": "Android: outcome of a purchase. Fired when the billing flow started by `purchaseProduct` ends, and for\npurchases made outside the app (promo codes, Play Store) while it is running.",
        "complexTypes": [
          "PluginListenerHandle",
          "AndroidPurchasedTrigger"
        ],
        "slug": "addlistenerandroid-purchase-response-"
      }
    ],
